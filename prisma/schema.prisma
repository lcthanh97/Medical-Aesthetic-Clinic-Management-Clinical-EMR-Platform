generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. TÀI KHOẢN & PHÂN QUYỀN
model Account {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  email        String?       @unique
  status       String        @default("ACTIVE")
  employee     Employee?
  roles        AccountRole[]
  auditLogs    AuditLog[]
  refreshTokens RefreshToken[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model RefreshToken {
  id        String    @id @default(cuid())
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  account   Account   @relation(fields: [accountId], references: [id])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  accounts    AccountRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  code  String           @unique
  roles RolePermission[]
}

model AccountRole {
  accountId String
  roleId    String
  account   Account @relation(fields: [accountId], references: [id])
  role      Role    @relation(fields: [roleId], references: [id])

  @@id([accountId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  accountId String?
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  createdAt DateTime @default(now())
  account   Account? @relation(fields: [accountId], references: [id])
}

// 2. CƠ SỞ & NHÂN SỰ
model ClinicFacility {
  id          String       @id @default(cuid())
  name        String
  departments Department[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Department {
  id         String         @id @default(cuid())
  facilityId String
  name       String
  facility   ClinicFacility @relation(fields: [facilityId], references: [id])
  rooms      Room[]
  employees  Employee[]
}

model Room {
  id           String        @id @default(cuid())
  departmentId String
  name         String
  department   Department    @relation(fields: [departmentId], references: [id])
  visits       Visit[]
  appointments Appointment[]
}

model Employee {
  id            String         @id @default(cuid())
  accountId     String?        @unique
  departmentId  String?
  employeeCode  String         @unique
  fullName      String
  account       Account?       @relation(fields: [accountId], references: [id])
  department    Department?    @relation(fields: [departmentId], references: [id])
  schedules     WorkSchedule[]
  visits        Visit[]
  prescriptions Prescription[]
  appointments  Appointment[]
  
  clinicalOrders          ClinicalOrder[]
  treatmentPlansCreated   TreatmentPlan[] @relation("PlanCreatedBy")
  protocolTemplates       TreatmentProtocolTemplate[] @relation("TemplateCreatedBy")
  treatmentSessions       TreatmentSession[] @relation("SessionPerformedBy")
  imagesCaptured          TreatmentImage[] @relation("ImageCapturedBy")
  imagesHidden            TreatmentImage[] @relation("ImageHiddenBy")
  imageNotes              ImageNoteRevision[] @relation("ImageNoteAuthor")
  equipmentUsages         EquipmentUsage[]
  equipmentMaintenances   EquipmentMaintenance[]
  treatmentConsumptions   TreatmentConsumption[]
  inventoryTransactions   InventoryTransaction[]
  consentsSigned          SignedConsent[] @relation("ConsentSignedByEmployee")
}

model WorkSchedule {
  id         String   @id @default(cuid())
  employeeId String
  workDate   DateTime
  startTime  DateTime
  endTime    DateTime
  employee   Employee @relation(fields: [employeeId], references: [id])
}

// 3. BỆNH NHÂN & TIẾP NHẬN
model Patient {
  id           String           @id @default(cuid())
  patientCode  String           @unique
  fullName     String
  dateOfBirth  DateTime?
  phone        String?
  allergies    Allergy[]
  histories    MedicalHistory[]
  appointments Appointment[]
  visits       Visit[]
  treatmentPlans TreatmentPlan[]
  consents     SignedConsent[]  @relation("ConsentSignedByPatient")
}

model Allergy {
  id            String    @id @default(cuid())
  patientId     String
  substance     String
  reaction      String?
  severity      String?
  diagnosisDate DateTime?
  patient       Patient   @relation(fields: [patientId], references: [id])
}

model MedicalHistory {
  id            String    @id @default(cuid())
  patientId     String
  type          String
  content       String
  diagnosisDate DateTime?
  patient       Patient   @relation(fields: [patientId], references: [id])
}

model Appointment {
  id                 String    @id @default(cuid())
  patientId          String
  roomId             String?
  employeeId         String?
  treatmentSessionId String?
  scheduledAt        DateTime
  status             String
  
  patient          Patient           @relation(fields: [patientId], references: [id])
  room             Room?             @relation(fields: [roomId], references: [id])
  employee         Employee?         @relation(fields: [employeeId], references: [id])
  treatmentSession TreatmentSession? @relation(fields: [treatmentSessionId], references: [id])
}

model Visit {
  id              String           @id @default(cuid())
  patientId       String
  employeeId      String?
  roomId          String?
  visitDate       DateTime         @default(now())
  status          String
  
  patient         Patient          @relation(fields: [patientId], references: [id])
  employee        Employee?        @relation(fields: [employeeId], references: [id])
  room            Room?            @relation(fields: [roomId], references: [id])
  
  medicalRecord   MedicalRecord?
  orders          ClinicalOrder[]
  treatmentPlans  TreatmentPlan[]
  treatmentSessions TreatmentSession[]
  treatmentImages TreatmentImage[]
  prescriptions   Prescription[]
  invoices        Invoice[]
  equipmentUsages EquipmentUsage[]
  consents        SignedConsent[]
  interactionAlerts InteractionAlert[]
}

model MedicalRecord {
  id                   String  @id @default(cuid())
  visitId              String  @unique
  preliminaryDiagnosis String?
  finalDiagnosis       String?
  notes                String?
  visit                Visit   @relation(fields: [visitId], references: [id])
}

// 4. CẬN LÂM SÀNG
model ServiceCatalog {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  category    String
  basePrice   Decimal
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  clinicalOrders ClinicalOrder[]
  invoiceItems   InvoiceItem[]
}

model ClinicalOrder {
  id          String          @id @default(cuid())
  visitId     String
  serviceId   String?
  orderedById String?
  type        String
  status      String
  orderedAt   DateTime        @default(now())
  
  visit       Visit           @relation(fields: [visitId], references: [id])
  service     ServiceCatalog? @relation(fields: [serviceId], references: [id])
  orderedBy   Employee?       @relation(fields: [orderedById], references: [id])
  
  labResults     LabResult[]
  imagingResults ImagingResult[]
  invoiceItems   InvoiceItem[]
}

model LabResult {
  id       String        @id @default(cuid())
  orderId  String
  testName String
  result   String
  unit     String?
  finding               String?
  professionalConclusion String?
  fileUrl               String?
  fileMimeType          String?
  fileName              String?
  order    ClinicalOrder @relation(fields: [orderId], references: [id])
}

model ImagingResult {
  id          String        @id @default(cuid())
  orderId     String
  imagingType String
  conclusion  String
  fileUrl     String?
  finding               String?
  professionalConclusion String?
  fileMimeType          String?
  fileName              String?
  order       ClinicalOrder @relation(fields: [orderId], references: [id])
}

// 5. MẪU PHÁC ĐỒ
model ProcedureCatalog {
  id                     String   @id @default(cuid())
  code                   String   @unique
  name                   String
  category               String
  description            String?
  defaultDurationMinutes Int?
  basePrice              Decimal?
  requiresConsent        Boolean  @default(false)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  
  protocolSteps ProtocolStepTemplate[]
  treatmentSteps TreatmentStep[]
}

model TreatmentProtocolTemplate {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  description      String?
  indication       String?
  contraindication String?
  version          Int
  status           String
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  createdBy        Employee @relation("TemplateCreatedBy", fields: [createdById], references: [id])
  stages           ProtocolStageTemplate[]
  treatmentPlans   TreatmentPlan[]
}

model ProtocolStageTemplate {
  id                 String   @id @default(cuid())
  protocolId         String
  stageType          String
  name               String
  orderNo            Int
  goal               String?
  durationDays       Int?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  protocol           TreatmentProtocolTemplate @relation(fields: [protocolId], references: [id])
  steps              ProtocolStepTemplate[]
}

model ProtocolStepTemplate {
  id                      String   @id @default(cuid())
  stageTemplateId         String
  procedureId             String?
  orderNo                 Int
  instruction             String
  repeatCount             Int
  intervalDays            Int?
  plannedDurationMinutes  Int?
  defaultParameters       Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  stageTemplate           ProtocolStageTemplate @relation(fields: [stageTemplateId], references: [id])
  procedure               ProcedureCatalog?     @relation(fields: [procedureId], references: [id])
  materials               ProtocolStepMaterial[]
}

model ProtocolStepMaterial {
  id              String   @id @default(cuid())
  stepTemplateId  String
  medicineId      String?
  supplyId        String?
  plannedQuantity Decimal
  unit            String
  notes           String?
  createdAt       DateTime @default(now())
  
  stepTemplate    ProtocolStepTemplate @relation(fields: [stepTemplateId], references: [id])
  medicine        Medicine?            @relation(fields: [medicineId], references: [id])
  supply          Supply?              @relation(fields: [supplyId], references: [id])
}

// 6. ĐIỀU TRỊ
model TreatmentPlan {
  id                 String   @id @default(cuid())
  patientId          String
  visitId            String
  protocolTemplateId String?
  name               String
  diagnosisSummary   String?
  goal               String?
  status             String
  version            Int
  createdById        String
  startDate          DateTime?
  expectedEndDate    DateTime?
  completedAt        DateTime?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  patient            Patient                    @relation(fields: [patientId], references: [id])
  visit              Visit                      @relation(fields: [visitId], references: [id])
  protocolTemplate   TreatmentProtocolTemplate? @relation(fields: [protocolTemplateId], references: [id])
  createdBy          Employee                   @relation("PlanCreatedBy", fields: [createdById], references: [id])
  
  stages             TreatmentStage[]
  images             TreatmentImage[]
  consents           SignedConsent[]
  interactionAlerts  InteractionAlert[]
  invoiceItems       InvoiceItem[]
}

model TreatmentStage {
  id                 String   @id @default(cuid())
  planId             String
  stageType          String
  name               String
  orderNo            Int
  goal               String?
  plannedStartDate   DateTime?
  plannedEndDate     DateTime?
  actualStartDate    DateTime?
  actualEndDate      DateTime?
  status             String
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  plan               TreatmentPlan   @relation(fields: [planId], references: [id])
  steps              TreatmentStep[]
  sessions           TreatmentSession[]
}

model TreatmentStep {
  id                     String   @id @default(cuid())
  stageId                String
  procedureId            String?
  orderNo                Int
  content                String
  repeatCount            Int
  intervalDays           Int?
  plannedDurationMinutes Int?
  defaultParameters      Json?
  status                 String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  
  stage                  TreatmentStage    @relation(fields: [stageId], references: [id])
  procedure              ProcedureCatalog? @relation(fields: [procedureId], references: [id])
  sessions               TreatmentSession[]
}

model TreatmentSession {
  id               String   @id @default(cuid())
  stageId          String
  stepId           String?
  visitId          String
  sessionNo        Int
  scheduledAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  performedById    String?
  treatmentArea    String?
  clinicalNotes    String?
  patientResponse  String?
  adverseReaction  String?
  status           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  stage            TreatmentStage   @relation(fields: [stageId], references: [id])
  step             TreatmentStep?   @relation(fields: [stepId], references: [id])
  visit            Visit            @relation(fields: [visitId], references: [id])
  performedBy      Employee?        @relation("SessionPerformedBy", fields: [performedById], references: [id])
  
  consumptions     TreatmentConsumption[]
  images           TreatmentImage[]
  equipmentUsages  EquipmentUsage[]
  appointments     Appointment[]
}

model TreatmentImage {
  id           String   @id @default(cuid())
  planId       String
  sessionId    String?
  visitId      String
  imageUrl     String
  imageType    String
  phase        String
  bodyArea     String?
  description  String?
  capturedAt   DateTime
  capturedById String?
  mimeType     String?
  fileSizeBytes Int?
  checksumSha256 String?
  isHidden     Boolean  @default(false)
  hiddenReason String?
  hiddenById   String?
  hiddenAt     DateTime?
  createdAt    DateTime @default(now())
  
  plan         TreatmentPlan     @relation(fields: [planId], references: [id])
  session      TreatmentSession? @relation(fields: [sessionId], references: [id])
  visit        Visit             @relation(fields: [visitId], references: [id])
  capturedBy   Employee?         @relation("ImageCapturedBy", fields: [capturedById], references: [id])
  hiddenBy     Employee?         @relation("ImageHiddenBy", fields: [hiddenById], references: [id], onDelete: SetNull)
  notes        ImageNoteRevision[]

  @@index([visitId, capturedAt])
  @@index([isHidden, capturedAt])
  @@unique([planId, checksumSha256, capturedAt])
}

model ImageNoteRevision {
  id        String   @id @default(cuid())
  imageId   String
  version   Int
  text      String
  authorId  String
  createdAt DateTime @default(now())

  image     TreatmentImage @relation(fields: [imageId], references: [id], onDelete: Restrict)
  author    Employee       @relation("ImageNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([imageId, version])
  @@index([imageId, createdAt])
}

model InteractionAlert {
  id               String   @id @default(cuid())
  visitId          String
  treatmentPlanId  String?
  interactionId    String?
  severity         String
  message          String
  status           String
  resolvedAt       DateTime?
  createdAt        DateTime @default(now())
  
  visit            Visit                  @relation(fields: [visitId], references: [id])
  treatmentPlan    TreatmentPlan?         @relation(fields: [treatmentPlanId], references: [id])
  interaction      IngredientInteraction? @relation(fields: [interactionId], references: [id])
}

// 7. THUỐC & HOẠT CHẤT
model Medicine {
  id               String             @id @default(cuid())
  name             String
  unit             String
  stock            Decimal            @default(0)
  unitCost         Decimal            @default(0)
  minStock         Decimal            @default(0)
  status           String             @default("ACTIVE")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  
  items            PrescriptionItem[]
  ingredients      MedicineIngredient[]
  stepMaterials    ProtocolStepMaterial[]
  consumptions     TreatmentConsumption[]
  transactions     InventoryTransaction[]
}

model ActiveIngredient {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String   @unique
  description  String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  medicines    MedicineIngredient[]
  interactionsA IngredientInteraction[] @relation("IngredientA")
  interactionsB IngredientInteraction[] @relation("IngredientB")
}

model MedicineIngredient {
  medicineId        String
  ingredientId      String
  concentration     Decimal?
  concentrationUnit String?
  
  medicine          Medicine         @relation(fields: [medicineId], references: [id])
  ingredient        ActiveIngredient @relation(fields: [ingredientId], references: [id])

  @@id([medicineId, ingredientId])
}

model IngredientInteraction {
  id                 String   @id @default(cuid())
  ingredientAId      String
  ingredientBId      String
  interactionType    String
  severity           String
  description        String
  recommendation     String?
  minIntervalHours   Int?
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  ingredientA        ActiveIngredient   @relation("IngredientA", fields: [ingredientAId], references: [id])
  ingredientB        ActiveIngredient   @relation("IngredientB", fields: [ingredientBId], references: [id])
  alerts             InteractionAlert[]
  
  @@unique([ingredientAId, ingredientBId, interactionType])
}

model Prescription {
  id         String             @id @default(cuid())
  visitId    String
  employeeId String
  status     String
  
  visit      Visit              @relation(fields: [visitId], references: [id])
  employee   Employee           @relation(fields: [employeeId], references: [id])
  items      PrescriptionItem[]
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  medicineId     String
  quantity       Decimal
  dosage         String
  
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  medicine       Medicine     @relation(fields: [medicineId], references: [id])
}

// 8. KHO & THIẾT BỊ
model Supply {
  id        String   @id @default(cuid())
  name      String
  unit      String
  stock     Decimal  @default(0)
  unitCost  Decimal  @default(0)
  minStock  Decimal  @default(0)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  stepMaterials ProtocolStepMaterial[]
  consumptions  TreatmentConsumption[]
  transactions  InventoryTransaction[]
}

model Equipment {
  id           String   @id @default(cuid())
  name         String
  serial       String   @unique
  status       String
  
  usages       EquipmentUsage[]
  maintenances EquipmentMaintenance[]
}

model EquipmentUsage {
  id                 String   @id @default(cuid())
  equipmentId        String
  visitId            String
  treatmentSessionId String?
  operatorId         String?
  startedAt          DateTime
  endedAt            DateTime?
  parameters         Json?
  createdAt          DateTime @default(now())
  
  equipment          Equipment         @relation(fields: [equipmentId], references: [id])
  visit              Visit             @relation(fields: [visitId], references: [id])
  session            TreatmentSession? @relation(fields: [treatmentSessionId], references: [id])
  operator           Employee?         @relation(fields: [operatorId], references: [id])
}

model EquipmentMaintenance {
  id              String   @id @default(cuid())
  equipmentId     String
  performedById   String?
  maintenanceType String
  scheduledAt     DateTime?
  completedAt     DateTime?
  status          String
  notes           String?
  cost            Decimal?
  createdAt       DateTime @default(now())
  
  equipment       Equipment @relation(fields: [equipmentId], references: [id])
  performedBy     Employee? @relation(fields: [performedById], references: [id])
}

model TreatmentConsumption {
  id              String   @id @default(cuid())
  sessionId       String
  medicineId      String?
  supplyId        String?
  plannedQuantity Decimal?
  actualQuantity  Decimal
  unit            String
  unitCost        Decimal
  totalCost       Decimal
  recordedById    String
  createdAt       DateTime @default(now())
  
  session         TreatmentSession @relation(fields: [sessionId], references: [id])
  medicine        Medicine?        @relation(fields: [medicineId], references: [id])
  supply          Supply?          @relation(fields: [supplyId], references: [id])
  recordedBy      Employee         @relation(fields: [recordedById], references: [id])
}

model InventoryTransaction {
  id              String   @id @default(cuid())
  medicineId      String?
  supplyId        String?
  transactionType String
  quantity        Decimal
  unit            String
  referenceType   String?
  referenceId     String?
  balanceBefore   Decimal
  balanceAfter    Decimal
  createdById     String
  notes           String?
  createdAt       DateTime @default(now())
  
  medicine        Medicine? @relation(fields: [medicineId], references: [id])
  supply          Supply?   @relation(fields: [supplyId], references: [id])
  createdBy       Employee  @relation(fields: [createdById], references: [id])
}

// 9. ĐỒNG Ý, THANH TOÁN & THÔNG BÁO
model ConsentTemplate {
  id             String          @id @default(cuid())
  name           String
  version        Int
  content        String
  
  signedConsents SignedConsent[]
}

model SignedConsent {
  id                 String   @id @default(cuid())
  templateId         String
  visitId            String
  treatmentPlanId    String?
  planVersion        Int?
  signedByPatientId  String?
  signedByEmployeeId String?
  signerName         String
  signatureUrl       String
  documentUrl        String?
  signedAt           DateTime
  createdAt          DateTime @default(now())
  
  template           ConsentTemplate @relation(fields: [templateId], references: [id])
  visit              Visit           @relation(fields: [visitId], references: [id])
  plan               TreatmentPlan?  @relation(fields: [treatmentPlanId], references: [id])
  patient            Patient?        @relation("ConsentSignedByPatient", fields: [signedByPatientId], references: [id])
  employee           Employee?       @relation("ConsentSignedByEmployee", fields: [signedByEmployeeId], references: [id])
  
  audits             ConsentAudit[]
}

model ConsentAudit {
  id              String   @id @default(cuid())
  signedConsentId String
  accountId       String?
  action          String
  evidenceUrl     String?
  ipAddress       String?
  createdAt       DateTime @default(now())
  
  consent         SignedConsent @relation(fields: [signedConsentId], references: [id])
}

model Invoice {
  id       String    @id @default(cuid())
  visitId  String
  total    Decimal
  status   String
  
  visit    Visit     @relation(fields: [visitId], references: [id])
  items    InvoiceItem[]
  payments Payment[]
}

model InvoiceItem {
  id              String   @id @default(cuid())
  invoiceId       String
  serviceId       String?
  clinicalOrderId String?
  treatmentPlanId String?
  itemType        String
  description     String
  quantity        Decimal
  unitPrice       Decimal
  discount        Decimal
  total           Decimal
  
  invoice         Invoice         @relation(fields: [invoiceId], references: [id])
  service         ServiceCatalog? @relation(fields: [serviceId], references: [id])
  order           ClinicalOrder?  @relation(fields: [clinicalOrderId], references: [id])
  plan            TreatmentPlan?  @relation(fields: [treatmentPlanId], references: [id])
  
  paymentAllocations PaymentAllocation[]
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  amount      Decimal
  method      String
  paidAt      DateTime
  
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  allocations PaymentAllocation[]
}

model PaymentAllocation {
  paymentId     String
  invoiceItemId String
  amount        Decimal
  
  payment       Payment     @relation(fields: [paymentId], references: [id])
  invoiceItem   InvoiceItem @relation(fields: [invoiceItemId], references: [id])
  
  @@id([paymentId, invoiceItemId])
}

model Notification {
  id          String   @id @default(cuid())
  recipient   String
  type        String
  content     String
  status      String
  scheduledAt DateTime?
  
  deliveries  NotificationDelivery[]
}

model NotificationDelivery {
  id                 String   @id @default(cuid())
  notificationId     String
  channel            String
  providerMessageId  String?
  status             String
  attemptedAt        DateTime
  deliveredAt        DateTime?
  errorMessage       String?
  
  notification       Notification @relation(fields: [notificationId], references: [id])
}
