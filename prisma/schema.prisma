generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id            String         @id @default(cuid())
  username      String         @unique
  passwordHash  String
  email         String?        @unique
  status        String         @default("ACTIVE")
  employee      Employee?
  roles         AccountRole[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model RefreshToken {
  id        String    @id @default(cuid())
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  accounts    AccountRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  code  String           @unique
  roles RolePermission[]
}

model AccountRole {
  accountId String
  roleId    String
  account   Account @relation(fields: [accountId], references: [id])
  role      Role    @relation(fields: [roleId], references: [id])

  @@id([accountId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model ClinicFacility {
  id          String       @id @default(cuid())
  name        String
  departments Department[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Department {
  id         String         @id @default(cuid())
  facilityId String
  name       String
  facility   ClinicFacility @relation(fields: [facilityId], references: [id])
  rooms      Room[]
  employees  Employee[]
}

model Room {
  id           String        @id @default(cuid())
  departmentId String
  name         String
  department   Department    @relation(fields: [departmentId], references: [id])
  visits       Visit[]
  appointments Appointment[]
}

model Employee {
  id                      String                      @id @default(cuid())
  accountId               String?                     @unique
  departmentId            String?
  employeeCode            String                      @unique
  fullName                String
  account                 Account?                    @relation(fields: [accountId], references: [id])
  department              Department?                 @relation(fields: [departmentId], references: [id])
  schedules               WorkSchedule[]
  visits                  Visit[]
  prescriptions           Prescription[]
  appointments            Appointment[]
  clinicalOrders          ClinicalOrder[]
  treatmentSessions       TreatmentSession[]          @relation("SessionPerformer")
  createdTreatmentPlans   TreatmentPlan[]             @relation("PlanCreator")
  createdProtocols        TreatmentProtocolTemplate[]
  capturedTreatmentImages TreatmentImage[]
  operatedEquipmentUsages EquipmentUsage[]            @relation("EquipmentOperator")
  recordedConsumptions    TreatmentConsumption[]
  inventoryTransactions   InventoryTransaction[]
  employeeConsents        SignedConsent[]             @relation("ConsentEmployeeSigner")
  equipmentMaintenances   EquipmentMaintenance[]
}

model WorkSchedule {
  id         String   @id @default(cuid())
  employeeId String
  workDate   DateTime
  startTime  DateTime
  endTime    DateTime
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model Patient {
  id              String           @id @default(cuid())
  patientCode     String           @unique
  fullName        String
  dateOfBirth     DateTime?
  phone           String?
  allergies       Allergy[]
  histories       MedicalHistory[]
  appointments    Appointment[]
  visits          Visit[]
  treatmentPlans  TreatmentPlan[]
  patientConsents SignedConsent[]  @relation("ConsentPatientSigner")
}

model Allergy {
  id            String    @id @default(cuid())
  patientId     String
  substance     String
  reaction      String?
  severity      String?
  diagnosisDate DateTime?
  patient       Patient   @relation(fields: [patientId], references: [id])
}

model MedicalHistory {
  id            String    @id @default(cuid())
  patientId     String
  type          String
  content       String
  diagnosisDate DateTime?
  patient       Patient   @relation(fields: [patientId], references: [id])
}

model Appointment {
  id          String    @id @default(cuid())
  patientId   String
  roomId      String?
  employeeId  String?
  scheduledAt DateTime
  status      String
  patient     Patient   @relation(fields: [patientId], references: [id])
  room        Room?     @relation(fields: [roomId], references: [id])
  employee    Employee? @relation(fields: [employeeId], references: [id])

  @@index([scheduledAt, status])
}

model Visit {
  id                String             @id @default(cuid())
  patientId         String
  employeeId        String?
  roomId            String?
  visitDate         DateTime           @default(now())
  status            String
  patient           Patient            @relation(fields: [patientId], references: [id])
  employee          Employee?          @relation(fields: [employeeId], references: [id])
  room              Room?              @relation(fields: [roomId], references: [id])
  medicalRecord     MedicalRecord?
  orders            ClinicalOrder[]
  treatmentPlans    TreatmentPlan[]
  treatmentSessions TreatmentSession[]
  prescriptions     Prescription[]
  invoices          Invoice[]
  equipmentUsages   EquipmentUsage[]
  consents          SignedConsent[]
  treatmentImages   TreatmentImage[]
  interactionAlerts InteractionAlert[]
}

model MedicalRecord {
  id                   String  @id @default(cuid())
  visitId              String  @unique
  preliminaryDiagnosis String?
  finalDiagnosis       String?
  notes                String?
  visit                Visit   @relation(fields: [visitId], references: [id])
}

model ClinicalOrder {
  id             String          @id @default(cuid())
  visitId        String
  serviceId      String?
  orderedById    String?
  type           String
  status         String
  orderedAt      DateTime        @default(now())
  visit          Visit           @relation(fields: [visitId], references: [id])
  service        ServiceCatalog? @relation(fields: [serviceId], references: [id])
  orderedBy      Employee?       @relation(fields: [orderedById], references: [id])
  labResults     LabResult[]
  imagingResults ImagingResult[]
  invoiceItems   InvoiceItem[]

  @@index([visitId, status])
}

model ServiceCatalog {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  category       String
  basePrice      Decimal         @default(0)
  active         Boolean         @default(true)
  clinicalOrders ClinicalOrder[]
  invoiceItems   InvoiceItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model LabResult {
  id       String        @id @default(cuid())
  orderId  String
  testName String
  result   String
  unit     String?
  order    ClinicalOrder @relation(fields: [orderId], references: [id])
}

model ImagingResult {
  id          String        @id @default(cuid())
  orderId     String
  imagingType String
  conclusion  String
  fileUrl     String?
  order       ClinicalOrder @relation(fields: [orderId], references: [id])
}

model TreatmentPlan {
  id                 String                     @id @default(cuid())
  patientId          String
  visitId            String
  protocolTemplateId String?
  name               String
  diagnosisSummary   String?
  goal               String?
  status             String                     @default("DRAFT")
  version            Int                        @default(1)
  createdById        String
  startDate          DateTime?
  expectedEndDate    DateTime?
  completedAt        DateTime?
  notes              String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  patient            Patient                    @relation(fields: [patientId], references: [id])
  visit              Visit                      @relation(fields: [visitId], references: [id])
  protocolTemplate   TreatmentProtocolTemplate? @relation(fields: [protocolTemplateId], references: [id])
  createdBy          Employee                   @relation("PlanCreator", fields: [createdById], references: [id])
  stages             TreatmentStage[]
  images             TreatmentImage[]
  signedConsents     SignedConsent[]
  interactionAlerts  InteractionAlert[]

  @@index([patientId, status])
  @@index([visitId])
}

model TreatmentProtocolTemplate {
  id               String                  @id @default(cuid())
  code             String
  name             String
  description      String?
  indication       String?
  contraindication String?
  version          Int                     @default(1)
  status           String
  createdById      String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  createdBy        Employee                @relation(fields: [createdById], references: [id])
  stages           ProtocolStageTemplate[]
  treatmentPlans   TreatmentPlan[]

  @@unique([code, version])
}

model ProtocolStageTemplate {
  id           String                    @id @default(cuid())
  protocolId   String
  stageType    String
  name         String
  orderNo      Int
  goal         String?
  durationDays Int?
  notes        String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  protocol     TreatmentProtocolTemplate @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  steps        ProtocolStepTemplate[]

  @@unique([protocolId, orderNo])
}

model ProtocolStepTemplate {
  id                     String                 @id @default(cuid())
  stageTemplateId        String
  procedureId            String?
  orderNo                Int
  instruction            String
  repeatCount            Int                    @default(1)
  intervalDays           Int?
  plannedDurationMinutes Int?
  defaultParameters      Json?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  stageTemplate          ProtocolStageTemplate  @relation(fields: [stageTemplateId], references: [id], onDelete: Cascade)
  procedure              ProcedureCatalog?      @relation(fields: [procedureId], references: [id])
  materials              ProtocolStepMaterial[]

  @@unique([stageTemplateId, orderNo])
}

model ProtocolStepMaterial {
  id              String               @id @default(cuid())
  stepTemplateId  String
  medicineId      String?
  supplyId        String?
  plannedQuantity Decimal
  unit            String
  notes           String?
  createdAt       DateTime             @default(now())
  stepTemplate    ProtocolStepTemplate @relation(fields: [stepTemplateId], references: [id], onDelete: Cascade)
  medicine        Medicine?            @relation(fields: [medicineId], references: [id])
  supply          Supply?              @relation(fields: [supplyId], references: [id])

  @@index([stepTemplateId])
}

model ProcedureCatalog {
  id                     String                 @id @default(cuid())
  code                   String                 @unique
  name                   String
  category               String
  description            String?
  defaultDurationMinutes Int?
  basePrice              Decimal?
  requiresConsent        Boolean                @default(false)
  isActive               Boolean                @default(true)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  protocolSteps          ProtocolStepTemplate[]
  treatmentSteps         TreatmentStep[]
}

model TreatmentStage {
  id               String             @id @default(cuid())
  planId           String
  stageType        String
  name             String
  orderNo          Int
  goal             String?
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  status           String             @default("PENDING")
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  plan             TreatmentPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  steps            TreatmentStep[]
  sessions         TreatmentSession[]

  @@unique([planId, orderNo])
  @@index([planId, status])
}

model TreatmentStep {
  id                     String             @id @default(cuid())
  stageId                String
  procedureId            String?
  orderNo                Int
  content                String
  repeatCount            Int                @default(1)
  intervalDays           Int?
  plannedDurationMinutes Int?
  defaultParameters      Json?
  status                 String
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  stage                  TreatmentStage     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  procedure              ProcedureCatalog?  @relation(fields: [procedureId], references: [id])
  sessions               TreatmentSession[]

  @@unique([stageId, orderNo])
}

model TreatmentSession {
  id              String                 @id @default(cuid())
  stageId         String
  stepId          String?
  visitId         String
  sessionNo       Int
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  performedById   String?
  treatmentArea   String?
  clinicalNotes   String?
  patientResponse String?
  adverseReaction String?
  status          String                 @default("SCHEDULED")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  stage           TreatmentStage         @relation(fields: [stageId], references: [id], onDelete: Cascade)
  step            TreatmentStep?         @relation(fields: [stepId], references: [id])
  visit           Visit                  @relation(fields: [visitId], references: [id])
  performedBy     Employee?              @relation("SessionPerformer", fields: [performedById], references: [id])
  consumptions    TreatmentConsumption[]
  equipmentUsages EquipmentUsage[]
  images          TreatmentImage[]

  @@unique([stageId, sessionNo])
  @@index([visitId, status])
}

model TreatmentImage {
  id           String            @id @default(cuid())
  planId       String
  sessionId    String?
  visitId      String
  imageUrl     String
  imageType    String
  phase        String
  bodyArea     String?
  description  String?
  capturedAt   DateTime
  capturedById String?
  createdAt    DateTime          @default(now())
  plan         TreatmentPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  session      TreatmentSession? @relation(fields: [sessionId], references: [id])
  visit        Visit             @relation(fields: [visitId], references: [id])
  capturedBy   Employee?         @relation(fields: [capturedById], references: [id])

  @@index([planId, capturedAt])
}

model Medicine {
  id                    String                 @id @default(cuid())
  name                  String
  unit                  String
  stock                 Decimal                @default(0)
  unitCost              Decimal                @default(0)
  minStock              Decimal                @default(0)
  status                String                 @default("ACTIVE")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  items                 PrescriptionItem[]
  ingredients           MedicineIngredient[]
  protocolMaterials     ProtocolStepMaterial[]
  consumptions          TreatmentConsumption[]
  inventoryTransactions InventoryTransaction[]
}

model Prescription {
  id         String             @id @default(cuid())
  visitId    String
  employeeId String
  status     String
  visit      Visit              @relation(fields: [visitId], references: [id])
  employee   Employee           @relation(fields: [employeeId], references: [id])
  items      PrescriptionItem[]
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  medicineId     String
  quantity       Decimal
  dosage         String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  medicine       Medicine     @relation(fields: [medicineId], references: [id])
}

model Supply {
  id                    String                 @id @default(cuid())
  name                  String
  unit                  String
  stock                 Decimal                @default(0)
  unitCost              Decimal                @default(0)
  minStock              Decimal                @default(0)
  status                String                 @default("ACTIVE")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  protocolMaterials     ProtocolStepMaterial[]
  consumptions          TreatmentConsumption[]
  inventoryTransactions InventoryTransaction[]
}

model TreatmentConsumption {
  id              String           @id @default(cuid())
  sessionId       String
  medicineId      String?
  supplyId        String?
  plannedQuantity Decimal?
  actualQuantity  Decimal
  unit            String
  unitCost        Decimal
  totalCost       Decimal
  recordedById    String
  createdAt       DateTime         @default(now())
  session         TreatmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  medicine        Medicine?        @relation(fields: [medicineId], references: [id])
  supply          Supply?          @relation(fields: [supplyId], references: [id])
  recordedBy      Employee         @relation(fields: [recordedById], references: [id])

  @@index([sessionId])
}

model InventoryTransaction {
  id              String    @id @default(cuid())
  medicineId      String?
  supplyId        String?
  transactionType String
  quantity        Decimal
  unit            String
  referenceType   String?
  referenceId     String?
  balanceBefore   Decimal
  balanceAfter    Decimal
  createdById     String
  notes           String?
  createdAt       DateTime  @default(now())
  medicine        Medicine? @relation(fields: [medicineId], references: [id])
  supply          Supply?   @relation(fields: [supplyId], references: [id])
  createdBy       Employee  @relation(fields: [createdById], references: [id])

  @@index([medicineId, createdAt])
  @@index([supplyId, createdAt])
  @@index([referenceType, referenceId])
}

model ActiveIngredient {
  id                 String                  @id @default(cuid())
  code               String                  @unique
  name               String                  @unique
  description        String?
  status             String                  @default("ACTIVE")
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  medicines          MedicineIngredient[]
  sourceInteractions IngredientInteraction[] @relation("IngredientA")
  targetInteractions IngredientInteraction[] @relation("IngredientB")
}

model MedicineIngredient {
  medicineId        String
  ingredientId      String
  concentration     Decimal?
  concentrationUnit String?
  medicine          Medicine         @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  ingredient        ActiveIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([medicineId, ingredientId])
}

model IngredientInteraction {
  id               String             @id @default(cuid())
  ingredientAId    String
  ingredientBId    String
  interactionType  String
  severity         String
  description      String
  recommendation   String?
  minIntervalHours Int?
  status           String             @default("ACTIVE")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  ingredientA      ActiveIngredient   @relation("IngredientA", fields: [ingredientAId], references: [id])
  ingredientB      ActiveIngredient   @relation("IngredientB", fields: [ingredientBId], references: [id])
  alerts           InteractionAlert[]

  @@unique([ingredientAId, ingredientBId, interactionType])
}

model Equipment {
  id           String                 @id @default(cuid())
  name         String
  serial       String                 @unique
  status       String
  usages       EquipmentUsage[]
  maintenances EquipmentMaintenance[]
}

model EquipmentUsage {
  id                 String            @id @default(cuid())
  equipmentId        String
  visitId            String
  treatmentSessionId String?
  operatorId         String?
  startedAt          DateTime
  endedAt            DateTime?
  parameters         Json?
  createdAt          DateTime          @default(now())
  equipment          Equipment         @relation(fields: [equipmentId], references: [id])
  visit              Visit             @relation(fields: [visitId], references: [id])
  treatmentSession   TreatmentSession? @relation(fields: [treatmentSessionId], references: [id])
  operator           Employee?         @relation("EquipmentOperator", fields: [operatorId], references: [id])
}

model EquipmentMaintenance {
  id              String    @id @default(cuid())
  equipmentId     String
  performedById   String?
  maintenanceType String
  scheduledAt     DateTime?
  completedAt     DateTime?
  status          String
  notes           String?
  cost            Decimal?
  equipment       Equipment @relation(fields: [equipmentId], references: [id])
  performedBy     Employee? @relation(fields: [performedById], references: [id])

  @@index([equipmentId, status])
}

model ConsentTemplate {
  id             String          @id @default(cuid())
  name           String
  version        Int
  content        String
  signedConsents SignedConsent[]
}

model SignedConsent {
  id                 String          @id @default(cuid())
  templateId         String
  visitId            String
  treatmentPlanId    String?
  planVersion        Int?
  signedByPatientId  String?
  signedByEmployeeId String?
  signerName         String
  signatureUrl       String
  documentUrl        String?
  signedAt           DateTime
  createdAt          DateTime        @default(now())
  template           ConsentTemplate @relation(fields: [templateId], references: [id])
  visit              Visit           @relation(fields: [visitId], references: [id])
  treatmentPlan      TreatmentPlan?  @relation(fields: [treatmentPlanId], references: [id])
  signedByPatient    Patient?        @relation("ConsentPatientSigner", fields: [signedByPatientId], references: [id])
  signedByEmployee   Employee?       @relation("ConsentEmployeeSigner", fields: [signedByEmployeeId], references: [id])
  audits             ConsentAudit[]

  @@index([treatmentPlanId])
}

model ConsentAudit {
  id              String        @id @default(cuid())
  signedConsentId String
  accountId       String?
  action          String
  evidenceUrl     String?
  ipAddress       String?
  createdAt       DateTime      @default(now())
  signedConsent   SignedConsent @relation(fields: [signedConsentId], references: [id], onDelete: Cascade)

  @@index([signedConsentId, createdAt])
}

model Invoice {
  id       String        @id @default(cuid())
  visitId  String
  total    Decimal
  status   String
  visit    Visit         @relation(fields: [visitId], references: [id])
  payments Payment[]
  items    InvoiceItem[]
}

model InvoiceItem {
  id              String              @id @default(cuid())
  invoiceId       String
  serviceId       String?
  clinicalOrderId String?
  itemType        String
  description     String
  quantity        Decimal             @default(1)
  unitPrice       Decimal
  discount        Decimal             @default(0)
  total           Decimal
  invoice         Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service         ServiceCatalog?     @relation(fields: [serviceId], references: [id])
  clinicalOrder   ClinicalOrder?      @relation(fields: [clinicalOrderId], references: [id])
  allocations     PaymentAllocation[]

  @@index([invoiceId])
}

model Payment {
  id          String              @id @default(cuid())
  invoiceId   String
  amount      Decimal
  method      String
  paidAt      DateTime
  invoice     Invoice             @relation(fields: [invoiceId], references: [id])
  allocations PaymentAllocation[]
}

model PaymentAllocation {
  id            String      @id @default(cuid())
  paymentId     String
  invoiceItemId String
  amount        Decimal
  payment       Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceItem   InvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)

  @@unique([paymentId, invoiceItemId])
}

model Notification {
  id          String                 @id @default(cuid())
  recipient   String
  type        String
  content     String
  status      String
  scheduledAt DateTime?
  deliveries  NotificationDelivery[]
}

model NotificationDelivery {
  id                String       @id @default(cuid())
  notificationId    String
  channel           String
  providerMessageId String?
  status            String
  attemptedAt       DateTime     @default(now())
  deliveredAt       DateTime?
  errorMessage      String?
  notification      Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, attemptedAt])
}

model InteractionAlert {
  id              String                 @id @default(cuid())
  visitId         String
  treatmentPlanId String?
  interactionId   String?
  severity        String
  message         String
  status          String                 @default("OPEN")
  createdAt       DateTime               @default(now())
  resolvedAt      DateTime?
  visit           Visit                  @relation(fields: [visitId], references: [id])
  treatmentPlan   TreatmentPlan?         @relation(fields: [treatmentPlanId], references: [id])
  interaction     IngredientInteraction? @relation(fields: [interactionId], references: [id])

  @@index([visitId, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  accountId String?
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  createdAt DateTime @default(now())
  account   Account? @relation(fields: [accountId], references: [id])
}
