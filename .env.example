DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://user:password@localhost:5432/clinic"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
AUTH_RATE_LIMIT_SECRET=
EMR_AUTHORIZATION_ENABLED=false
# Enable only after production database and account-role assignments are verified.
DOCTOR_NEON_READ_ENABLED=false
# Optional: enable draft-only Neon writes for one account and an explicit list
# of demo Visits. Leave disabled for normal installations.
DOCTOR_NEON_PRESCRIPTION_DRAFT_WRITE_ENABLED=false
DOCTOR_NEON_PRESCRIPTION_ACCOUNT_ID=
DOCTOR_NEON_PRESCRIPTION_EMPLOYEE_ID=
DOCTOR_NEON_PRESCRIPTION_VISIT_IDS=
# Neon Object Storage branch credentials; keep all values server-only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
NEON_STORAGE_BUCKET=clinical-results
EMR_IMAGE_CONSENT_TEMPLATE_NAME=Đồng ý lưu ảnh lâm sàng
NEXT_PUBLIC_APP_URL=http://localhost:3000
