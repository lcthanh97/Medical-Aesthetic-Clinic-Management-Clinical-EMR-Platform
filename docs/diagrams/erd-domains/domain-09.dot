digraph ERD {
graph [charset="UTF-8", bgcolor="white", pad="0.3", nodesep="0.55", ranksep="0.85", splines=ortho, overlap=false, outputorder=edgesfirst, label="ERD CHI TIẾT – ĐỒNG Ý, THANH TOÁN &amp; THÔNG BÁO", labelloc=t, fontsize=26, fontname="Arial Bold"];
