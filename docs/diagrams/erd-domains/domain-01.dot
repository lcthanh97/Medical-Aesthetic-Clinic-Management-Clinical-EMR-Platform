digraph ERD {
graph [charset="UTF-8", bgcolor="white", pad="0.3", nodesep="0.55", ranksep="0.85", splines=ortho, overlap=false, outputorder=edgesfirst, label="ERD CHI TIẾT – TÀI KHOẢN &amp; PHÂN QUYỀN", labelloc=t, fontsize=26, fontname="Arial Bold"];
node [fontname="Arial", color="black"];
edge [fontname="Arial Bold", fontsize=18, color="black", penwidth=2.1, arrowsize=0.8];
subgraph cluster_main { label="BẢNG THUỘC PHÂN HỆ"; fontsize=17; fontname="Arial Bold"; color="#666666"; style="dashed"; margin=24;
"Account" [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#E5E5E5"><FONT POINT-SIZE="16"><B>Account</B></FONT></TD></TR><HR/><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B></TD><TD PORT="f_id" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>id</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>UK</B></TD><TD PORT="f_username" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>username</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>&#160;</B></TD><TD PORT="f_passwordHash" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>passwordHash</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>UK</B></TD><TD PORT="f_email" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>email?</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>&#160;</B></TD><TD PORT="f_status" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>status</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>&#160;</B></TD><TD PORT="f_createdAt" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>createdAt</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">timestamp</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>&#160;</B></TD><TD PORT="f_updatedAt" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>updatedAt</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">timestamp</FONT></TD></TR></TABLE>>];
"RefreshToken" [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#E5E5E5"><FONT POINT-SIZE="16"><B>RefreshToken</B></FONT></TD></TR><HR/><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B></TD><TD PORT="f_id" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>id</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>FK</B></TD><TD PORT="f_accountId" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>accountId</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>UK</B></TD><TD PORT="f_tokenHash" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>tokenHash</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>&#160;</B></TD><TD PORT="f_expiresAt" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>expiresAt</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">timestamp</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>&#160;</B></TD><TD PORT="f_revokedAt" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>revokedAt?</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">timestamp</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>&#160;</B></TD><TD PORT="f_createdAt" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>createdAt</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">timestamp</FONT></TD></TR></TABLE>>];
"Role" [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#E5E5E5"><FONT POINT-SIZE="16"><B>Role</B></FONT></TD></TR><HR/><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B></TD><TD PORT="f_id" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>id</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>UK</B></TD><TD PORT="f_name" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>name</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR></TABLE>>];
"Permission" [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#E5E5E5"><FONT POINT-SIZE="16"><B>Permission</B></FONT></TD></TR><HR/><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B></TD><TD PORT="f_id" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>id</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>UK</B></TD><TD PORT="f_code" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>code</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR></TABLE>>];
"AccountRole" [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#E5E5E5"><FONT POINT-SIZE="16"><B>AccountRole</B></FONT></TD></TR><HR/><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK/FK</B></TD><TD PORT="f_accountId" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>accountId</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>PK/FK</B></TD><TD PORT="f_roleId" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>roleId</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR></TABLE>>];
"RolePermission" [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#E5E5E5"><FONT POINT-SIZE="16"><B>RolePermission</B></FONT></TD></TR><HR/><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK/FK</B></TD><TD PORT="f_roleId" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>roleId</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>PK/FK</B></TD><TD PORT="f_permissionId" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>permissionId</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR></TABLE>>];
"AuditLog" [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#E5E5E5"><FONT POINT-SIZE="16"><B>AuditLog</B></FONT></TD></TR><HR/><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B></TD><TD PORT="f_id" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>id</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>FK</B></TD><TD PORT="f_accountId" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>accountId?</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>&#160;</B></TD><TD PORT="f_action" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>action</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>&#160;</B></TD><TD PORT="f_entity" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>entity</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>&#160;</B></TD><TD PORT="f_entityId" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>entityId?</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>&#160;</B></TD><TD PORT="f_ipAddress" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>ipAddress?</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>&#160;</B></TD><TD PORT="f_createdAt" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>createdAt</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">timestamp</FONT></TD></TR></TABLE>>];
}
subgraph cluster_external { label="BẢNG LIÊN QUAN"; fontsize=17; fontname="Arial Bold"; color="#999999"; style="dashed"; margin=24;
"Employee" [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#E5E5E5"><FONT POINT-SIZE="16"><B>Employee</B></FONT></TD></TR><HR/><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B></TD><TD PORT="f_id" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>id</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>FK/UK</B></TD><TD PORT="f_accountId" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>accountId?</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>FK</B></TD><TD PORT="f_departmentId" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>departmentId?</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>UK</B></TD><TD PORT="f_employeeCode" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>employeeCode</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>&#160;</B></TD><TD PORT="f_fullName" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>fullName</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR></TABLE>>];
}
"rel_001" [shape=diamond, fixedsize=true, width=0.78, height=0.56, label="có", fontsize=12, style="filled", fillcolor="white", penwidth=1.8];
"Account":f_id:e -> "rel_001":w [dir=none, xlabel="1"];
"rel_001":e -> "RefreshToken":f_accountId:w [xlabel="N"];
"rel_002" [shape=diamond, fixedsize=true, width=0.78, height=0.56, label="có", fontsize=12, style="filled", fillcolor="white", penwidth=1.8];
