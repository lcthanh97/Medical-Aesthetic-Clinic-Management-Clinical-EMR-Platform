><B>quantity</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">decimal</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>&#160;</B></TD><TD PORT="f_unitPrice" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>unitPrice</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">decimal</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>&#160;</B></TD><TD PORT="f_discount" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>discount</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">decimal</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>&#160;</B></TD><TD PORT="f_total" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>total</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">decimal</FONT></TD></TR></TABLE>>];
"Visit" [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#E5E5E5"><FONT POINT-SIZE="16"><B>Visit</B></FONT></TD></TR><HR/><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B></TD><TD PORT="f_id" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>id</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>FK</B></TD><TD PORT="f_patientId" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>patientId</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>FK</B></TD><TD PORT="f_employeeId" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>employeeId?</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>FK</B></TD><TD PORT="f_roomId" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>roomId?</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>&#160;</B></TD><TD PORT="f_visitDate" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>visitDate</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">timestamp</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>&#160;</B></TD><TD PORT="f_status" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>status</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR></TABLE>>];
}
