digraph ERD {
graph [charset="UTF-8", bgcolor="white", pad="0.3", nodesep="0.55", ranksep="0.85", splines=ortho, overlap=false, outputorder=edgesfirst, label="ERD CHI TIẾT – CẬN LÂM SÀNG", labelloc=t, fontsize=26, fontname="Arial Bold"];
node [fontname="Arial", color="black"];
edge [fontname="Arial Bold", fontsize=18, color="black", penwidth=2.1, arrowsize=0.8];
subgraph cluster_main { label="BẢNG THUỘC PHÂN HỆ"; fontsize=17; fontname="Arial Bold"; color="#666666"; style="dashed"; margin=24;
"ClinicalOrder" [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#E5E5E5"><FONT POINT-SIZE="16"><B>ClinicalOrder</B></FONT></TD></TR><HR/><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B></TD><TD PORT="f_id" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>id</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>FK</B></TD><TD PORT="f_visitId" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>visitId</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>FK</B></TD><TD PORT="f_serviceId" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>serviceId?</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>FK</B></TD><TD PORT="f_orderedById" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>orderedById?</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>&#160;</B></TD><TD PORT="f_type" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>type</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>&#160;</B></TD><TD PORT="f_status" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>status</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>&#160;</B></TD><TD PORT="f_orderedAt" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>orderedAt</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">timestamp</FONT></TD></TR></TABLE>>];
"ServiceCatalog" [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#E5E5E5"><FONT POINT-SIZE="16"><B>ServiceCatalog</B></FONT></TD></TR><HR/><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B></TD><TD PORT="f_id" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>id</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>UK</B></TD><TD PORT="f_code" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>code</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>&#160;</B></TD><TD PORT="f_name" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>name</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>&#160;</B></TD><TD PORT="f_category" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>category</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>&#160;</B></TD><TD PORT="f_basePrice" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>basePrice</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">decimal</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>&#160;</B></TD><TD PORT="f_active" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>active</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">bool</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>&#160;</B></TD><TD PORT="f_createdAt" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>createdAt</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">timestamp</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>&#160;</B></TD><TD PORT="f_updatedAt" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>updatedAt</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">timestamp</FONT></TD></TR></TABLE>>];
"LabResult" [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#E5E5E5"><FONT POINT-SIZE="16"><B>LabResult</B></FONT></TD></TR><HR/><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B></TD><TD PORT="f_id" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>id</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>FK</B></TD><TD PORT="f_orderId" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>orderId</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>&#160;</B></TD><TD PORT="f_testName" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>testName</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>&#160;</B></TD><TD PORT="f_result" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>result</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>&#160;</B></TD><TD PORT="f_unit" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>unit?</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR></TABLE>>];
"ImagingResult" [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#E5E5E5"><FONT POINT-SIZE="16"><B>ImagingResult</B></FONT></TD></TR><HR/><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B></TD><TD PORT="f_id" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>id</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>FK</B></TD><TD PORT="f_orderId" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>orderId</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>&#160;</B></TD><TD PORT="f_imagingType" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>imagingType</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#F7F7F7"><B>&#160;</B></TD><TD PORT="f_conclusion" WIDTH="170" ALIGN="LEFT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="13"><B>conclusion</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#F7F7F7"><FONT POINT-SIZE="11">text</FONT></TD></TR><TR><TD WIDTH="52" ALIGN="LEFT" BGCOLOR="#FFFFFF"><B>&#160;</B></TD><TD PORT="f_fileUrl" WIDTH="170" ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="13"><B>fileUrl?</B></FONT></TD><TD WIDTH="92" ALIGN="RIGHT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="11">text</FONT></TD></TR></TABLE>>];
