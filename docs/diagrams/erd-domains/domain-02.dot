digraph ERD {
graph [charset="UTF-8", bgcolor="white", pad="0.3", nodesep="0.55", ranksep="0.85", splines=ortho, overlap=false, outputorder=edgesfirst, label="ERD CHI TIẾT – CƠ SỞ &amp; NHÂN SỰ", labelloc=t, fontsize=26, fontname="Arial Bold"];
node [fontname="Arial", color="black"];
edge [fontname="Arial Bold", fontsize=18, color="black", penwidth=2.1, arrowsize=0.8];
