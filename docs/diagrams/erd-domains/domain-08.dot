digraph ERD {
graph [charset="UTF-8", bgcolor="white", pad="0.3", nodesep="0.55", ranksep="0.85", splines=ortho, overlap=false, outputorder=edgesfirst, label="ERD CHI TIẾT – KHO &amp; THIẾT BỊ", labelloc=t, fontsize=26, fontname="Arial Bold"];
